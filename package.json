{
  "name": "lokal",
  "private": true,
  "type": "module",
  "description": "Indonesia-ready toolkit for AI agents: skills, MCP server, and privacy guard",
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "packages/ner"
  ],
  "scripts": {
    "build": "npm run build -w @lokal-id/core && npm run build -w @lokal-id/ner && npm run build -w @lokal-id/mcp && npm run bundle:hook",
    "bundle:hook": "esbuild packages/mcp/src/guard.ts --bundle --platform=node --format=esm --target=node20 --outfile=hooks/samaran-guard.mjs --log-level=warning",
    "test": "node --test \"packages/*/test/*.test.ts\"",
    "eval": "node evals/run.mjs",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/mcp --noEmit && tsc -p packages/ner --noEmit && tsc -p packages/extension",
    "eval:pii": "node evals/hard/pii-bench.mjs",
    "bench": "node evals/bench/run.mjs",
    "bench:chat": "node evals/chat/run.mjs",
    "stress": "node --expose-gc evals/stress/run.mjs",
    "eval:alamat": "node evals/alamat-bench.mjs",
    "eval:alamat:osm": "node evals/alamat-osm.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "test:extension": "node scripts/build-extension.mjs --test && node scripts/test-extension.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ai": "^7.0.148",
    "ai-v6": "npm:ai@^6.0.312",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokal-id/lokal.git"
  },
  "license": "MIT"
}
